rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Membership Logic: User has a profile that points to a valid account
    function isMember() {
      let profilePath = /databases/$(database)/documents/profiles/$(request.auth.uid);
      return isSignedIn() && exists(profilePath);
    }
    
    function isAdmin() {
      if (!isMember()) return false;
      let profile = get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
      let accountPath = /databases/$(database)/documents/accounts/$(profile.code);
      return exists(accountPath) && get(accountPath).data.role == 'admin';
    }

    // 2. Validation Blueprints
    
    function isValidAccount(data) {
      let required = ['role', 'createdAt'];
      return data.keys().hasAll(required) && data.keys().size() == 2
        && data.role in ['admin', 'member']
        && data.createdAt == request.time;
    }

    function isValidProfile(data, uid) {
      let required = ['code', 'linkedAt'];
      return data.keys().hasAll(required) && data.keys().size() == 2
        && data.code is string && data.code.size() <= 100
        && data.linkedAt == request.time
        && exists(/databases/$(database)/documents/accounts/$(data.code));
    }

    function isValidExpense(data, isCreate) {
      let required = ['date', 'desc', 'amount', 'payer', 'split', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(['date', 'desc', 'amount', 'payer', 'split', 'createdAt', 'updatedAt'])
        && data.keys().size() >= 7 && data.keys().size() <= 12
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.desc is string && data.desc.size() <= 1000
        && data.amount is number && data.amount >= 0
        && data.payer is string && data.payer.size() <= 200
        && data.split is list && data.split.size() <= 100
        && (isCreate ? data.createdAt == request.time : data.createdAt == existing().createdAt)
        && data.updatedAt == request.time
        // Protect nested structures if present
        && (!data.keys().hasAny(['shares']) || data.shares is map)
        && (!data.keys().hasAny(['paidBy']) || data.paidBy is map)
        && (!data.keys().hasAny(['customAmounts']) || data.customAmounts is map);
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['members', 'title', 'defaultPayer', 'passcode', 'updatedAt'])
        && data.members is list && data.members.size() <= 100
        && data.title is string && data.title.size() <= 500
        && data.defaultPayer is string && data.defaultPayer.size() <= 200
        && data.passcode is string && data.passcode.size() <= 100
        && data.updatedAt == request.time;
    }

    // 4. Collection Rules
    
    match /accounts/{code} {
      allow get: if isSignedIn();
      allow list: if isMember();
      // Only admins or the bootstrapping logic can create/write accounts
      allow create: if isSignedIn() && (
        isAdmin() || 
        (code == 'tan.nd.05' && !exists(/databases/$(database)/documents/accounts/tan.nd.05))
      ) && isValidAccount(incoming());
      allow update, delete: if isAdmin();
    }
    
    match /profiles/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfile(incoming(), uid);
    }

    match /expenses/{expenseId} {
      allow read: if isMember();
      allow create: if isMember() && isValidId(expenseId) && isValidExpense(incoming(), true);
      allow update: if isMember() && isValidId(expenseId) && isValidExpense(incoming(), false);
      allow delete: if isAdmin() || isMember();
    }

    match /settings/{settingId} {
      allow read: if isMember();
      allow write: if isAdmin() && isValidId(settingId) && isValidSettings(incoming());
    }

    match /settlements/{month} {
      // Allow read for any member to see monthly status
      allow read: if isMember();
      // Only admins can mark settlements as paid
      allow write: if isAdmin() && isValidId(month);
    }
  }
}
