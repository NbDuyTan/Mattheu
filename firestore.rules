rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Validation Blueprints
    function isValidExpense(data, isCreate) {
      let requiredFields = ['date', 'desc', 'amount', 'payer', 'split', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields)
        && (data.keys().size() == 7 || (data.keys().hasAll(['shares']) && data.keys().size() == 8))
        && data.date is string && data.date.size() == 10
        && data.desc is string && data.desc.size() <= 500
        && data.amount is number && data.amount >= 0
        && data.payer is string && data.payer.size() <= 100
        && data.split is list && data.split.size() > 0 && data.split.size() <= 50
        && (isCreate ? data.createdAt == request.time : data.createdAt == existing().createdAt)
        && data.updatedAt == request.time;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['members', 'title', 'defaultPayer', 'passcode', 'updatedAt'])
        && data.keys().size() == 5
        && data.members is list && data.members.size() >= 0 && data.members.size() <= 100
        && data.title is string && data.title.size() <= 200
        && data.defaultPayer is string && data.defaultPayer.size() <= 100
        && data.passcode is string && data.passcode.size() <= 100
        && data.updatedAt == request.time;
    }

    // 4. Collection Rules
    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() 
        && isValidId(expenseId)
        && isValidExpense(incoming(), true);
        
      allow update: if isSignedIn()
        && isValidId(expenseId)
        && isValidExpense(incoming(), false)
        && (
          // Action: Edit Record
          incoming().diff(existing()).affectedKeys().hasOnly(['date', 'desc', 'amount', 'payer', 'split', 'shares', 'updatedAt'])
        );
        
      allow delete: if isSignedIn() && isValidId(expenseId);
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn()
        && isValidId(settingId)
        && isValidSettings(incoming());
        
      allow update: if isSignedIn()
        && isValidId(settingId)
        && isValidSettings(incoming())
        && (
          // Action: Update Settings
          incoming().diff(existing()).affectedKeys().hasOnly(['members', 'title', 'defaultPayer', 'passcode', 'updatedAt'])
        );
    }
  }
}
