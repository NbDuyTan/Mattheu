rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // New Authorization Helpers
    function getProfileData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
    
    function isMember() {
      return isSignedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isMember() && get(/databases/$(database)/documents/accounts/$(getProfileData().code)).data.role == 'admin';
    }

    // 2. Validation Blueprints
    function isValidExpense(data, isCreate) {
      let requiredFields = ['date', 'desc', 'amount', 'payer', 'split', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields)
        && (data.keys().size() == 7 || (data.keys().hasAll(['shares']) && data.keys().size() == 8))
        && data.date is string && data.date.size() == 10
        && data.desc is string && data.desc.size() <= 500
        && data.amount is number && data.amount >= 0
        && data.payer is string && data.payer.size() <= 100
        && data.split is list && data.split.size() > 0 && data.split.size() <= 50
        && (isCreate ? data.createdAt == request.time : data.createdAt == existing().createdAt)
        && data.updatedAt == request.time;
    }

    function isValidSettings(data) {
      let requiredFields = ['members', 'title', 'defaultPayer', 'passcode', 'updatedAt'];
      return data.keys().hasAll(requiredFields)
        && data.keys().size() == 5
        && data.members is list && data.members.size() >= 0 && data.members.size() <= 100
        && data.title is string && data.title.size() <= 200
        && data.defaultPayer is string && data.defaultPayer.size() <= 100
        && data.passcode is string && data.passcode.size() <= 100
        && data.updatedAt == request.time;
    }

    // 4. Collection Rules
    
    match /accounts/{code} {
      // Any signed in user can 'get' a single account to check if it exists for login
      allow get: if isSignedIn();
      // Only members can list accounts (or see other details)
      allow list: if isMember();
      // Admin can manage accounts
      allow create, update, delete: if isAdmin();
      // Bootstrapping: Allow the first admin code to be created if it's the known one
      allow create: if isSignedIn() && code == 'tan.nd.05' && !exists(/databases/$(database)/documents/accounts/tan.nd.05);
    }
    
    match /profiles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid 
        && exists(/databases/$(database)/documents/accounts/$(incoming().code));
    }

    match /expenses/{expenseId} {
      allow read: if isMember();
      
      allow create: if isMember() 
        && isValidId(expenseId)
        && isValidExpense(incoming(), true);
        
      allow update: if isMember()
        && isValidId(expenseId)
        && isValidExpense(incoming(), false)
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['date', 'desc', 'amount', 'payer', 'split', 'shares', 'updatedAt'])
        );
        
      allow delete: if isMember() && isValidId(expenseId);
    }

    match /settings/{settingId} {
      allow read: if isMember();
      
      allow write: if isAdmin()
        && isValidId(settingId)
        && isValidSettings(incoming());
    }
  }
}
